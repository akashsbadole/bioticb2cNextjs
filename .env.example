# ─── Database ────────────────────────────────────────────────────
# SQLite (development):
# DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ─── Auth (JWT) ──────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="7d"

# Auth.js (NextAuth v5)
AUTH_SECRET="change-me-to-a-random-64-char-string"
NEXTAUTH_URL="http://localhost:3000"

# OTP
OTP_SECRET="change-me-to-a-random-32-char-string"

# ─── SMS (Twilio) ────────────────────────────────────────────────
# Leave blank to disable SMS OTP and use email OTP only
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ─── Multi-tenant / Store ────────────────────────────────────────
DEFAULT_STORE_SLUG="main"

# ─── Payment Gateway (PayU) ─────────────────────────────────────
# Get credentials from https://dashboard.payu.in
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_TEST_MODE="true"

# ─── reCAPTCHA ────────────────────────────────────────────────────
# Get keys from https://www.google.com/recaptcha/admin
# These can also be set in the Admin dashboard (Settings > reCAPTCHA)
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ─── Cron ────────────────────────────────────────────────────────
# Used to protect /api/cron/abandoned-carts
CRON_SECRET="change-me-to-a-random-32-char-string"

# ─── Site URL (used in emails, invoices) ─────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
