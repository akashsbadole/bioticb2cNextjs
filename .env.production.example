# ============================================================
# WCommerce - VPS deployment environment
# Copy this file to .env on the VPS and fill in the values:
#   cp .env.production.example .env
# Then: docker compose up -d
# ============================================================

# --- PostgreSQL (runs inside Docker on the VPS) ---
POSTGRES_DB=wcommerce
POSTGRES_USER=wcommerce
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Secrets (generate each with: openssl rand -hex 32) ---
JWT_SECRET=
AUTH_SECRET=
OTP_SECRET=
CRON_SECRET=

# --- Single-store mode: must match the store slug in the database ---
# The imported store is "vedika-ayurveda" (Vedika Ayurveda)
DEFAULT_STORE_SLUG=vedika-ayurveda
# Store id from the imported DB (keeps ids: use the id shown by
# "SELECT id FROM stores" after import). Avoids middleware self-fetch.
DEFAULT_STORE_ID=REPLACE_WITH_STORE_ID_FROM_IMPORTED_DB

# --- Branding (baked into the image at build time) ---
NEXT_PUBLIC_SITE_NAME=Biotic Naturals
NEXT_PUBLIC_SITE_URL=http://YOUR_VPS_IP:3000
NEXT_PUBLIC_SITE_DESCRIPTION=Authentic Ayurvedic wellness products
NEXT_PUBLIC_STORE_SLUG=vedika-ayurveda
NEXT_PUBLIC_PLATFORM_DOMAIN=wcommerce.com

# --- PayU Payment Gateway (optional - leave empty for COD/test mode) ---
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_TEST_MODE=true

# ============================================================
# One-time data import (run FROM YOUR MACHINE, not the VPS).
# Postgres only listens on the VPS localhost, so open an SSH
# tunnel first, then point the import at localhost:
#
#   ssh -L 5432:localhost:5432 user@VPS_IP
#   set TARGET_DATABASE_URL=postgresql://wcommerce:CHANGE_ME_STRONG_PASSWORD@localhost:5432/wcommerce
#   set SQLITE_PATH=db/bioticnaturals.db
#   npx tsx scripts/import-from-devdb.ts
# ============================================================
# TARGET_DATABASE_URL=
# SQLITE_PATH=db/bioticnaturals.db
